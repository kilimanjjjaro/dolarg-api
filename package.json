{
  "name": "dolarg-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "scrape": "tsx scraping/index.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:all": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "hono": "4.13.20",
    "picocolors": "1.1.1",
    "scrape-it": "6.1.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-love": "158.0.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "2.8.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0",
    "zod": "4.6.7"
  },
  "volta": {
    "node": "26.13.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
