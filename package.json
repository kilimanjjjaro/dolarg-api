{
  "name": "dolarg-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev api/index.ts",
    "deploy": "wrangler publish api/index.ts",
    "scrape": "tsx scraping/index.ts",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler publish --dry-run --outdir dist",
    "test:all": "pnpm format:check && pnpm typecheck && pnpm lint:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "hono": "4.13.20",
    "picocolors": "1.1.1",
    "scrape-it": "6.1.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230419.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-config-standard-with-typescript": "^34.0.1",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^2.8.8",
    "tsx": "4.23.15",
    "typescript": "^5.0.4",
    "vitest": "5.1.1",
    "wrangler": "2.20.0",
    "zod": "4.6.7"
  },
  "volta": {
    "node": "26.13.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
